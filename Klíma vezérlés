void connectWiFi() {
  Serial.println();
  Serial.print("Kapcsolodas: ");
  Serial.println(WIFI_SSID);

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  unsigned long startTime = millis();

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");

    if (millis() - startTime > 30000) {
      Serial.println();
      Serial.println("Wi-Fi timeout.");
      ESP.restart();
    }
  }

  Serial.println();
  Serial.println("Wi-Fi csatlakoztatva.");

  Serial.print("ESP32 IP: ");
  Serial.println(WiFi.localIP());
}

// ======================================================
// AES TITKOSITAS
// ======================================================

bool encryptPack(
  const String& plaintext,
  const String& key,
  String& encodedOutput
) {
  if (key.length() != 16) {
    return false;
  }

  size_t plainLength = plaintext.length();
  size_t paddingLength = 16 - (plainLength % 16);
  size_t paddedLength = plainLength + paddingLength;

  uint8_t* padded = new uint8_t[paddedLength];
  uint8_t* encrypted = new uint8_t[paddedLength];

  if (!padded || !encrypted) {
    delete[] padded;
    delete[] encrypted;
    return false;
  }

  memcpy(padded, plaintext.c_str(), plainLength);

  for (size_t i = plainLength; i < paddedLength; i++) {
    padded[i] = static_cast<uint8_t>(paddingLength);
  }

  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);

  int result = mbedtls_aes_setkey_enc(
    &aes,
    reinterpret_cast<const unsigned char*>(key.c_str()),
    128
  );

  if (result != 0) {
    mbedtls_aes_free(&aes);
    delete[] padded;
    delete[] encrypted;
    return false;
  }

  for (size_t offset = 0; offset < paddedLength; offset += 16) {
    result = mbedtls_aes_crypt_ecb(
      &aes,
      MBEDTLS_AES_ENCRYPT,
      padded + offset,
      encrypted + offset
    );

    if (result != 0) {
      mbedtls_aes_free(&aes);
      delete[] padded;
      delete[] encrypted;
      return false;
    }
  }

  mbedtls_aes_free(&aes);
  delete[] padded;

  size_t base64BufferSize =
    4 * ((paddedLength + 2) / 3) + 8;

  unsigned char* base64Buffer =
    new unsigned char[base64BufferSize];

  if (!base64Buffer) {
    delete[] encrypted;
    return false;
  }

  size_t base64Length = 0;

  result = mbedtls_base64_encode(
    base64Buffer,
    base64BufferSize,
    &base64Length,
    encrypted,
    paddedLength
  );

  delete[] encrypted;

  if (result != 0) {
    delete[] base64Buffer;
    return false;
  }

  base64Buffer[base64Length] = '\0';
  encodedOutput = reinterpret_cast<char*>(base64Buffer);

  delete[] base64Buffer;
  return true;
}

// ======================================================
// AES VISSZAFEJTES
// ======================================================

bool decryptPack(
  const String& encodedInput,
  const String& key,
  String& plaintextOutput
) {
  if (key.length() != 16) {
    return false;
  }

  size_t decodedBufferSize =
    (encodedInput.length() * 3) / 4 + 8;

  uint8_t* decoded = new uint8_t[decodedBufferSize];

  if (!decoded) {
    return false;
  }

  size_t decodedLength = 0;

  int result = mbedtls_base64_decode(
    decoded,
    decodedBufferSize,
    &decodedLength,
    reinterpret_cast<const unsigned char*>(encodedInput.c_str()),
    encodedInput.length()
  );

  if (
    result != 0 ||
    decodedLength == 0 ||
    decodedLength % 16 != 0
  ) {
    delete[] decoded;
    return false;
  }

  uint8_t* plaintext = new uint8_t[decodedLength + 1];

  if (!plaintext) {
    delete[] decoded;
    return false;
  }

  mbedtls_aes_context aes;
  mbedtls_aes_init(&aes);

  result = mbedtls_aes_setkey_dec(
    &aes,
    reinterpret_cast<const unsigned char*>(key.c_str()),
    128
  );

  if (result != 0) {
    mbedtls_aes_free(&aes);
    delete[] decoded;
    delete[] plaintext;
    return false;
  }

  for (size_t offset = 0; offset < decodedLength; offset += 16) {
    result = mbedtls_aes_crypt_ecb(
      &aes,
      MBEDTLS_AES_DECRYPT,
      decoded + offset,
      plaintext + offset
    );

    if (result != 0) {
      mbedtls_aes_free(&aes);
      delete[] decoded;
      delete[] plaintext;
      return false;
    }
  }

  mbedtls_aes_free(&aes);
  delete[] decoded;

  plaintext[decodedLength] = '\0';

  int jsonEnd = -1;

  for (int i = static_cast<int>(decodedLength) - 1; i >= 0; i--) {
    if (plaintext[i] == '}') {
      jsonEnd = i;
      break;
    }
  }

  if (jsonEnd < 0) {
    delete[] plaintext;
    return false;
  }

  plaintext[jsonEnd + 1] = '\0';
  plaintextOutput = reinterpret_cast<char*>(plaintext);

  delete[] plaintext;
  return true;
}

// ======================================================
// UDP KULDES
// ======================================================

bool sendUdp(
  const IPAddress& ip,
  const String& data
) {
  if (!udp.beginPacket(ip, GREE_PORT)) {
    return false;
  }

  udp.write(
    reinterpret_cast<const uint8_t*>(data.c_str()),
    data.length()
  );

  return udp.endPacket();
}

// ======================================================
// KULSO GREE CSOMAG
// ======================================================

String createOuterPacket(
  const String& mac,
  const String& encryptedPack,
  int packetId
) {
  String packet;

  packet.reserve(encryptedPack.length() + 120);

  packet += "{\"cid\":\"app\",\"i\":";
  packet += packetId;
  packet += ",\"t\":\"pack\",\"uid\":0,\"tcid\":\"";
  packet += mac;
  packet += "\",\"pack\":\"";
  packet += encryptedPack;
  packet += "\"}";

  return packet;
}

// ======================================================
// BIND
// ======================================================

void sendBind(int index) {
  GreeDevice& device = devices[index];

  String inner =
    "{\"mac\":\"" +
    device.mac +
    "\",\"t\":\"bind\",\"uid\":0}";

  String encrypted;

  if (!encryptPack(
        inner,
        String(GENERIC_KEY),
        encrypted
      )) {
    return;
  }

  String outer =
    createOuterPacket(
      device.mac,
      encrypted,
      1
    );

  if (sendUdp(device.ip, outer)) {
    device.awaitingBind = true;
    device.lastRequest = millis();

    Serial.print("Bind elkuldve: ");
    Serial.println(device.name);
  }
}

