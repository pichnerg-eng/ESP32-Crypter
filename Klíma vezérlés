bool processBindResponse(
  int index,
  JsonDocument& outer
) {
  GreeDevice& device = devices[index];

  String encoded = outer["pack"] | "";

  if (encoded.length() == 0) {
    return false;
  }

  String decrypted;

  if (!decryptPack(
        encoded,
        String(GENERIC_KEY),
        decrypted
      )) {
    return false;
  }

  JsonDocument inner;

  if (deserializeJson(inner, decrypted)) {
    return false;
  }

  const char* type = inner["t"] | "";

  if (strcasecmp(type, "bindok") != 0) {
    return false;
  }

  String receivedKey = inner["key"] | "";

  if (receivedKey.length() != 16) {
    return false;
  }

  device.key = receivedKey;
  device.bound = true;
  device.online = true;

  device.awaitingBind = false;
  device.lastResponse = millis();

  Serial.println();
  Serial.print("BIND SIKERES: ");
  Serial.println(device.name);

  delay(150);
  sendStatusRequest(index);

  return true;
}

// ======================================================
// STATUS VALASZ
// ======================================================

bool processStatusResponse(
  int index,
  JsonDocument& outer
) {
  GreeDevice& device = devices[index];

  if (
    !device.bound ||
    device.key.length() != 16
  ) {
    return false;
  }

  String encoded = outer["pack"] | "";

  if (encoded.length() == 0) {
    return false;
  }

  String decrypted;

  if (!decryptPack(
        encoded,
        device.key,
        decrypted
      )) {
    return false;
  }

  JsonDocument inner;

  if (deserializeJson(inner, decrypted)) {
    return false;
  }

  const char* type = inner["t"] | "";

  if (strcmp(type, "dat") != 0) {
    return false;
  }

  JsonArrayConst columns = inner["cols"];
  JsonArrayConst values  = inner["dat"];

  if (
    columns.isNull() ||
    values.isNull()
  ) {
    return false;
  }

  device.power =
    findStatusValue(columns, values, "Pow");

  device.mode =
    findStatusValue(columns, values, "Mod");

  device.setTemp =
    findStatusValue(columns, values, "SetTem");

  device.fanSpeed =
    findStatusValue(columns, values, "WdSpd");

  device.swing =
    findStatusValue(columns, values, "SwUpDn");

  device.turbo =
    findStatusValue(columns, values, "Tur");

  device.light =
    findStatusValue(columns, values, "Lig");

  device.quiet =
    findStatusValue(columns, values, "Quiet");

  device.health =
    findStatusValue(columns, values, "Health");

  device.insideTempRaw =
    findStatusValue(columns, values, "TemSen");

  device.awaitingStatus = false;
  device.online = true;
  device.lastResponse = millis();

  Serial.print("Status OK: ");
  Serial.print(device.name);

  Serial.print(" / Pow=");
  Serial.print(device.power);

  Serial.print(" Mod=");
  Serial.print(device.mode);

  Serial.print(" Temp=");
  Serial.print(device.setTemp);

  Serial.print(" SwUpDn=");
  Serial.print(device.swing);

  Serial.print(" Room=");

  if (device.insideTempRaw >= 40) {
    Serial.println(device.insideTempRaw - 40);
  } else {
    Serial.println("?");
  }

  return true;
}

// ======================================================
// UDP VALASZOK
// ======================================================

void processUdpPackets() {
  int packetSize = udp.parsePacket();

  while (packetSize > 0) {
    IPAddress remoteIp = udp.remoteIP();

    String received;
    received.reserve(packetSize + 1);

    while (udp.available()) {
      received += static_cast<char>(udp.read());
    }

    int index = findDeviceByIp(remoteIp);

    if (index >= 0) {
      JsonDocument outer;

      if (!deserializeJson(outer, received)) {
        bool processed = false;

        if (devices[index].awaitingBind) {
          processed =
            processBindResponse(index, outer);
        }

        if (
          !processed &&
          devices[index].bound
        ) {
          processStatusResponse(index, outer);
        }
      }
    }

    packetSize = udp.parsePacket();
  }
}

// ======================================================
// WEB API - ALLAPOT
// ======================================================

void handleState() {
  JsonDocument document;

  document["espIp"] =
    WiFi.localIP().toString();

  JsonArray array =
    document["devices"].to<JsonArray>();

  for (int i = 0; i < DEVICE_COUNT; i++) {
    GreeDevice& device = devices[i];

    JsonObject item =
      array.add<JsonObject>();

    item["name"] = device.name;
    item["ip"] = device.ip.toString();
    item["mac"] = device.mac;
    item["bound"] = device.bound;
    item["online"] = device.online;
    item["power"] = device.power;
    item["mode"] = device.mode;
    item["setTemp"] = device.setTemp;
    item["fanSpeed"] = device.fanSpeed;
    item["swing"] = device.swing;
    item["turbo"] = device.turbo;
    item["light"] = device.light;
    item["quiet"] = device.quiet;
    item["health"] = device.health;

    if (device.insideTempRaw >= 40) {
      item["insideTemp"] =
        device.insideTempRaw - 40;
    } else {
      item["insideTemp"] = nullptr;
    }
  }

  String response;
  serializeJson(document, response);

  server.send(
    200,
    "application/json",
    response
  );
}

// ======================================================
// WEB API - PARANCS
// ======================================================

void handleSet() {
  if (
    !server.hasArg("device") ||
    !server.hasArg("key") ||
    !server.hasArg("value")
  ) {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,"
      "\"message\":\"Hianyzo parameter\"}"
    );

    return;
  }

  int index = server.arg("device").toInt();
  String property = server.arg("key");
  int value = server.arg("value").toInt();

  bool validProperty =
    property == "Pow" ||
    property == "Mod" ||
    property == "SetTem" ||
    property == "WdSpd" ||
    property == "SwUpDn" ||
    property == "Tur" ||
    property == "Lig";

  if (
    index < 0 ||
    index >= DEVICE_COUNT ||
    !validProperty
  ) {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,"
      "\"message\":\"Ervenytelen parancs\"}"
    );

    return;
  }

  if (
    property == "SetTem" &&
    (value < 16 || value > 30)
  ) {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,"
      "\"message\":\"A homerseklet 16-30 C lehet\"}"
    );

    return;
  }

  if (
    property == "SwUpDn" &&
    (value < 0 || value > 11)
  ) {
    server.send(
      400,
      "application/json",
      "{\"ok\":false,"
      "\"message\":\"A SwUpDn ertek 0-11 lehet\"}"
    );

    return;
  }

  bool success =
    sendCommand(index, property, value);

  if (success) {
    server.send(
      200,
      "application/json",
      "{\"ok\":true,"
      "\"message\":\"Parancs elkuldve\"}"
    );
  } else {
    server.send(
      503,
      "application/json",
      "{\"ok\":false,"
      "\"message\":\"A klima nem erheto el vagy nincs bindelve\"}"
    );
  }
}

// ======================================================
// WEB KISZOLGALAS
// ======================================================

void setupWebServer() {
  server.on(
    "/",
    HTTP_GET,
    []() {
      server.send_P(
        200,
        "text/html; charset=utf-8",
        INDEX_HTML
      );
    }
  );

  server.on(
    "/api/state",
    HTTP_GET,
    handleState
  );

  server.on(
    "/api/set",
    HTTP_GET,
    handleSet
  );

  server.onNotFound(
    []() {
      server.send(
        404,
        "text/plain",
        "Not found"
      );
    }
  );

  server.begin();

  Serial.println("Webszerver elindult.");
}

// ======================================================
// TIMEOUTOK
// ======================================================

void handleTimeouts() {
  for (int i = 0; i < DEVICE_COUNT; i++) {
    GreeDevice& device = devices[i];

    if (
      device.awaitingBind &&
      millis() - device.lastRequest >
        RESPONSE_TIMEOUT
    ) {
      device.awaitingBind = false;
    }

    if (
      device.awaitingStatus &&
      millis() - device.lastRequest >
        RESPONSE_TIMEOUT
    ) {
      device.awaitingStatus = false;
    }

    if (
      device.lastResponse > 0 &&
      millis() - device.lastResponse >
        ONLINE_TIMEOUT
    ) {
      device.online = false;
    }
  }
}

// ======================================================
// SETUP
// ======================================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("==============================");
  Serial.println("ESP32 Gree webserver");
  Serial.println("==============================");

  connectWiFi();

  if (!udp.begin(LOCAL_PORT)) {
    Serial.println(
      "UDP 7000 inditasa sikertelen."
    );

    delay(2000);
    ESP.restart();
  }

  setupWebServer();

  Serial.println();
  Serial.println("Nyisd meg:");

  Serial.print("http://");
  Serial.print(WiFi.localIP());
  Serial.println("/");

  delay(500);

  for (int i = 0; i < DEVICE_COUNT; i++) {
    sendBind(i);
    delay(350);
  }

  lastBindCycle = millis();
  lastStatusCycle = millis();
}

// ======================================================
// LOOP
// ======================================================

void loop() {
  server.handleClient();

  processUdpPackets();
  handleTimeouts();

  if (WiFi.status() != WL_CONNECTED) {
    WiFi.disconnect();
    connectWiFi();
  }

  if (
    millis() - lastBindCycle >=
    BIND_RETRY_MS
  ) {
    lastBindCycle = millis();

    for (int i = 0; i < DEVICE_COUNT; i++) {
      if (
        !devices[i].bound &&
        !devices[i].awaitingBind
      ) {
        sendBind(i);
        delay(250);
      }
    }
  }

  if (
    millis() - lastStatusCycle >=
    STATUS_INTERVAL_MS
  ) {
    lastStatusCycle = millis();

    for (int i = 0; i < DEVICE_COUNT; i++) {
      if (
        devices[i].bound &&
        !devices[i].awaitingStatus
      ) {
        sendStatusRequest(i);
        delay(150);
      }
    }
  }

  delay(2);
}
