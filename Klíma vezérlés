// ======================================================
// PARANCSKULDES
// ======================================================

bool sendCommand(
  int index,
  const String& property,
  int value
) {
  if (
    index < 0 ||
    index >= DEVICE_COUNT
  ) {
    return false;
  }

  GreeDevice& device = devices[index];

  if (
    !device.bound ||
    device.key.length() != 16
  ) {
    return false;
  }

  String inner =
    "{\"opt\":[\"" +
    property +
    "\"],\"p\":[" +
    String(value) +
    "],\"t\":\"cmd\"}";

  String encrypted;

  if (!encryptPack(
        inner,
        device.key,
        encrypted
      )) {
    return false;
  }

  String outer =
    createOuterPacket(
      device.mac,
      encrypted,
      0
    );

  Serial.println();
  Serial.print("Parancs: ");
  Serial.print(device.name);
  Serial.print(" / ");
  Serial.print(property);
  Serial.print(" = ");
  Serial.println(value);

  bool sent = sendUdp(device.ip, outer);

  if (sent) {
    delay(150);
    sendStatusRequest(index);
  }

  return sent;
}

