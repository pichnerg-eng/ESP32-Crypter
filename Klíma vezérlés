int findDeviceByIp(
  const IPAddress& ip
) {
  for (int i = 0; i < DEVICE_COUNT; i++) {
    if (devices[i].ip == ip) {
      return i;
    }
  }

  return -1;
}

int findStatusValue(
  JsonArrayConst columns,
  JsonArrayConst values,
  const char* wantedColumn,
  int defaultValue = -1
) {
  size_t count =
    min(columns.size(), values.size());

  for (size_t i = 0; i < count; i++) {
    const char* column =
      columns[i] | "";

    if (strcmp(column, wantedColumn) == 0) {
      return values[i].as<int>();
    }
  }

  return defaultValue;
}

